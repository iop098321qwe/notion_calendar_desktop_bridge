{
  "name": "notion_calendar_desktop_bridge",
  "version": "0.0.0",
  "description": "bridge to open notion calendar items in notino desktop",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/notion-calendar-desktop-bridge.cjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iop098321qwe/notion_calendar_desktop_bridge.git"
  },
  "commit-and-tag-version": {
    "packageFiles": ["package.json"],
    "bumpFiles": [
      "package.json",
      "package-lock.json",
      { "filename": "extension/manifest.json", "type": "json" }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/iop098321qwe/notion_calendar_desktop_bridge/issues"
  },
  "homepage": "https://github.com/iop098321qwe/notion_calendar_desktop_bridge#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
